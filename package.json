{
  "name": "storm-chat",
  "version": "0.0.1",
  "description": "Simple RAG Chat - AI Engineering Study",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "pnpm --filter shared build && pnpm -r --filter=!shared build",
    "test": "pnpm -r test"
  },
  "keywords": [
    "RAG",
    "AI",
    "artificial",
    "inteligence",
    "chatbot",
    "ai-chatbot"
  ],
  "author": "Sérgio Segaty",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}